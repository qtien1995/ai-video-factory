  "voice": "Hải Đăng",
  "provider": "cit-voice-studio",
  "engine": "VieNeu-TTS-v3-Turbo (48kHz)",
  "cues": [
    {
      "start": 0.0,
      "end": 4.674,
      "text": "Rất nhiều người mua bảo hiểm với tâm lý đi\ngửi tiết kiệm: Đóng 200 triệu sau 10 năm,"
    },
    {
      "start": 4.674,
      "end": 8.292,
      "text": "đinh ninh trong đầu phải rút về\n250 đến 300 triệu cả gốc lẫn lãi."
    },
    {
      "start": 8.792,
      "end": 12.848,
      "text": "Đến lúc mở tài khoản thấy số tiền chỉ\nquanh quẩn huề vốn, thậm chí hụt một khoản,"
    },
    {
      "start": 12.848,
      "end": 15.852,
      "text": "cảm giác đầu tiên là tức giận:\n\"Hóa ra bảo hiểm lừa đảo à?\"."
    },
    {
      "start": 16.352,
      "end": 17.873,
      "text": "Khách hàng không sai khi xót tiền."
    },
    {
      "start": 18.292,
      "end": 22.363,
      "text": "Cái sai nằm ở sự mập mờ của lời tư vấn:\n\"Cứ đóng 10 năm rồi rút cả gốc lẫn lãi,"
    },
    {
      "start": 22.363,
      "end": 23.909,
      "text": "coi như được bảo vệ miễn phí\"."
    },
    {
      "start": 24.409,
      "end": 26.523,
      "text": "Trên đời này không có\nbữa trưa nào miễn phí!"
    },
    {
      "start": 26.949,
      "end": 30.921,
      "text": "Và càng không có công ty nào đứng ra bảo\nlãnh sinh mạng và viện phí tiền tỷ cho bạn"
    },
    {
      "start": 30.921,
      "end": 32.548,
      "text": "suốt một thập kỷ mà không thu phí."
    },
    {
      "start": 33.048,
      "end": 34.459,
      "text": "Trong 100 đồng bạn nộp vào:"
    },
    {
      "start": 34.859,
      "end": 39.762,
      "text": "Có một phần bị trừ hàng tháng gọi là Chi\nphí rủi ro — đây chính là tiền thuê vệ sĩ"
    },
    {
      "start": 39.762,
      "end": 43.11,
      "text": "túc trực 24/7 để sẵn sàng đền\n1 đến 2 tỷ nếu có biến cố."
    },
    {
      "start": 43.61,
      "end": 45.988,
      "text": "Chỉ có phần còn lại mới được\nmang đi đầu tư tích lũy."
    },
    {
      "start": 46.42,
      "end": 48.071,
      "text": "Lãi suất chỉ chạy trên phần này,"
    },
    {
      "start": 48.071,
      "end": 51.114,
      "text": "làm sao có thể đọ được với 100\nđồng nguyên vẹn ở ngân hàng?"
    },
    {
      "start": 51.614,
      "end": 53.782,
      "text": "Bạn dùng ngân hàng và\nchứng khoán để làm giàu."
    },
    {
      "start": 54.214,
      "end": 58.028,
      "text": "Nhưng bạn cần bảo hiểm để giữ cho mình không\nbị nghèo đi nếu chẳng may ngã ngựa giữa"
    },
    {
      "start": 58.028,
      "end": 58.301,
      "text": "đường."
    },
    {
      "start": 58.801,
      "end": 60.674,
      "text": "Đừng bắt bảo hiểm phải\nghi bàn như tiền đạo."
    },
    {
      "start": 61.091,
      "end": 62.575,
      "text": "Nhiệm vụ của nó là giữ gôn!"
    },
    {
      "start": 63.075,
      "end": 64.938,
      "text": "Tôi là Tiến Dương từ Tài Chính Thực Chiến."
    },
    {
      "start": 65.365,
      "end": 67.159,
      "text": "Hãy bình luận quan điểm của bạn bên dưới!"
    }
  ],
