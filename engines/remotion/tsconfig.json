{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@styles": ["../../styles/index.ts"],
      "@styles/*": ["../../styles/*"],
      "@shared": ["src/shared/index.ts"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "exclude": ["remotion.config.ts"]
}
