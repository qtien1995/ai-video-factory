{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gen-video.local/schemas/blueprint.schema.json",
  "title": "Gen Video Creative Blueprint",
  "type": "object",
  "required": ["version", "job_id", "status", "input", "domain", "big_idea", "creative_direction", "script", "scenes", "asset_board", "tts", "motion_audio", "sources", "branding", "creative_review"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "job_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["draft", "waiting_for_blueprint_approval", "approved", "rejected"]},
    "input": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": {"type": "string", "enum": ["idea", "url", "script", "mixed"]},
        "value": {"type": "string"},
        "attachments": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "domain": {
      "type": "object",
      "required": ["primary", "insurance_layer"],
      "properties": {
        "primary": {"type": "string"},
        "insurance_layer": {"type": "boolean"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "big_idea": {
      "type": "object",
      "required": ["topic", "audience", "primary_insight", "big_idea"],
      "properties": {
        "topic": {"type": "string"},
        "audience": {"type": "string"},
        "primary_insight": {"type": "string"},
        "emotional_tension": {"type": "string"},
        "desired_viewer_reaction": {"type": "string"},
        "big_idea": {"type": "string"}
      },
      "additionalProperties": true
    },
    "creative_direction": {
      "type": "object",
      "required": ["concept_name", "concept", "why_it_works", "visual_language", "overall_feel"],
      "properties": {
        "concept_name": {"type": "string"},
        "concept": {"type": "string"},
        "why_it_works": {"type": "string"},
        "visual_language": {"type": "array", "items": {"type": "string"}},
        "overall_feel": {"type": "string"},
        "reference_pattern_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "script": {
      "type": "object",
      "required": ["hook", "narration"],
      "properties": {
        "hook": {"type": "string"},
        "narration": {"type": "string"},
        "cta": {"type": ["string", "null"]},
        "estimated_duration_seconds": {"type": "number", "minimum": 1}
      },
      "additionalProperties": true
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_seconds", "end_seconds", "purpose", "voice", "visual", "asset_ids"],
        "properties": {
          "id": {"type": "string"},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "minimum": 0},
          "purpose": {"type": "string"},
          "voice": {"type": "string"},
          "on_screen_text": {"type": "array", "items": {"type": "string"}},
          "visual": {"type": "string", "minLength": 12},
          "camera": {"type": "string"},
          "motion": {"type": "string"},
          "transition": {"type": "string"},
          "asset_ids": {"type": "array", "items": {"type": "string"}},
          "fact_ids": {"type": "array", "items": {"type": "string"}},
          "wow_moment": {"type": "boolean", "default": false}
        },
        "additionalProperties": true
      }
    },
    "asset_board": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "purpose", "description", "source_status"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string", "enum": ["ARTICLE_IMAGE", "USER_IMAGE", "MANULIFE_ASSET", "REAL_PHOTO", "STOCK_VIDEO", "AI_IMAGE", "AI_VIDEO", "MOTION_GRAPHIC", "THREE_D", "MAP", "CHART", "INFOGRAPHIC", "TYPOGRAPHY", "ICON", "SCREENSHOT", "WEB_UI", "OTHER"]},
          "purpose": {"type": "string"},
          "description": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "source_status": {"type": "string", "enum": ["available", "to_acquire", "to_generate", "needs_permission_review", "unknown"]},
          "transformation": {"type": "string"},
          "usage_note": {"type": "string"},
          "generation_prompt": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "tts": {
      "type": "object",
      "required": ["voice_character", "tone", "pace", "delivery"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "voice_id": {"type": ["string", "null"]},
        "voice_character": {"type": "string"},
        "tone": {"type": "string"},
        "pace": {"type": "string"},
        "delivery": {"type": "string"},
        "emphasis_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "motion_audio": {
      "type": "object",
      "required": ["motion_language", "music_direction"],
      "properties": {
        "motion_language": {"type": "array", "items": {"type": "string"}},
        "music_direction": {"type": "string"},
        "audio_arc": {"type": "string"},
        "sfx": {"type": "array", "items": {"type": "string"}},
        "silence_notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "wow_moments": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["scene_id", "description", "reason"],
        "properties": {
          "scene_id": {"type": "string"},
          "description": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "claim", "status"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["FACT", "SOURCE_CLAIM", "INFERENCE", "HYPOTHETICAL", "PRODUCT_CLAIM", "ASSET_SOURCE"]},
          "claim": {"type": "string"},
          "source": {"type": ["string", "null"]},
          "status": {"type": "string", "enum": ["verified", "supported_by_source", "needs_verification", "not_applicable"]}
        },
        "additionalProperties": true
      }
    },
    "branding": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "brand": {"type": ["string", "null"]},
        "creator": {"type": ["string", "null"]},
        "logo_treatment": {"type": ["string", "null"]},
        "creator_treatment": {"type": ["string", "null"]},
        "outro": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "creative_review": {
      "type": "object",
      "required": ["hook", "creative_idea", "visual_diversity", "story_clarity", "emotional_impact", "generic_ai_risk"],
      "properties": {
        "hook": {"type": "integer", "minimum": 1, "maximum": 10},
        "creative_idea": {"type": "integer", "minimum": 1, "maximum": 10},
        "visual_diversity": {"type": "integer", "minimum": 1, "maximum": 10},
        "story_clarity": {"type": "integer", "minimum": 1, "maximum": 10},
        "emotional_impact": {"type": "integer", "minimum": 1, "maximum": 10},
        "brand_fit": {"type": ["integer", "null"], "minimum": 1, "maximum": 10},
        "generic_ai_risk": {"type": "integer", "minimum": 1, "maximum": 10},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
