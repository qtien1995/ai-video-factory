{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gen-video.local/schemas/production.schema.json",
  "title": "Gen Video Production Manifest",
  "type": "object",
  "required": ["version", "job_id", "state", "blueprint_path", "settings", "scenes", "assets", "audio", "branding", "qc", "outputs", "changes_from_blueprint"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "job_id": {"type": "string"},
    "state": {"type": "string", "enum": ["blueprint_approved", "preparing_assets", "building", "qc", "preview_ready", "render_approved", "rendered", "failed"]},
    "blueprint_path": {"type": "string"},
    "settings": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 1},
        "composition_id": {"type": "string"}
      },
      "additionalProperties": true
    },
    "scenes": {"type": "array", "items": {"type": "object"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string"},
          "status": {"type": "string", "enum": ["planned", "acquired", "generated", "prepared", "failed"]},
          "local_path": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]},
          "license_usage_note": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "tts_path": {"type": ["string", "null"]},
        "tts_duration_seconds": {"type": ["number", "null"]},
        "music_path": {"type": ["string", "null"]},
        "sfx": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "branding": {
      "type": "object",
      "required": ["insurance_layer", "logo_required", "creator_required"],
      "properties": {
        "insurance_layer": {"type": "boolean"},
        "logo_required": {"type": "boolean"},
        "logo_path": {"type": ["string", "null"]},
        "creator_required": {"type": "boolean"},
        "creator_name": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "component_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {"type": "string"},
          "path": {"type": "string"},
          "reused": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "qc": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "pass", "fail"]},
        "checks": {"type": "array", "items": {"type": "object"}},
        "auto_fixes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "changes_from_blueprint": {"type": "array", "items": {"type": "string"}},
    "outputs": {
      "type": "object",
      "properties": {
        "preview_url": {"type": ["string", "null"]},
        "preview_path": {"type": ["string", "null"]},
        "final_path": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
