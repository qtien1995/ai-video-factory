{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.gen-video/schemas/style.schema.json",
  "title": "Gen Video Style Pack",
  "type": "object",
  "required": ["id", "version", "name", "purpose", "bestFor", "notIdealFor", "beatSeconds", "script", "visual", "imagePrompt", "motion", "typography", "audio", "thumbnail", "renderer", "prohibited"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "bestFor": {"type": "array", "minItems": 1},
    "notIdealFor": {"type": "array"},
    "beatSeconds": {
      "type": "object",
      "required": ["min", "max", "resetEveryBeats"],
      "properties": {
        "min": {"type": "number", "exclusiveMinimum": 0},
        "max": {"type": "number", "exclusiveMinimum": 0},
        "resetEveryBeats": {"type": "integer", "minimum": 1}
      }
    },
    "script": {"type": "object"},
    "visual": {"type": "object"},
    "imagePrompt": {"type": "object"},
    "motion": {"type": "object"},
    "typography": {"type": "object"},
    "audio": {"type": "object"},
    "thumbnail": {"type": "object"},
    "renderer": {"type": "object"},
    "prohibited": {"type": "array"}
  },
  "additionalProperties": true
}
